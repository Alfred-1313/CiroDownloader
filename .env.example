# install.sh creates .env interactively. Never commit real credentials.
BOT_TOKEN=PUT_TOKEN_HERE
ADMIN_IDS=123456789
BOT_API_URL=https://api.telegram.org
MAX_FILE_BYTES=49000000
STORAGE_DIR=/app/storage
YT_DLP_BIN=/opt/yt/bin/yt-dlp
# Parallel media deliveries. Link inspection has a separate reserved slot.
WORKER_CONCURRENCY=3
# Optional: proxy applies only to YouTube requests, not Telegram.
YOUTUBE_PROXY=
# Default cookie path is /app/storage/youtube-cookies.txt (import from the manager).
YOUTUBE_COOKIES_FILE=
# Instagram posts, Reels and carousels use gallery-dl. Cookies are separate.
GALLERY_DL_BIN=/opt/yt/bin/gallery-dl
INSTAGRAM_COOKIES_FILE=
