FROM debian:bookworm-slim AS build
ARG BUILD_JOBS=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git g++ make cmake gperf libssl-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN git clone https://github.com/tdlib/telegram-bot-api.git /src \
    && cd /src && git checkout e3e9dd8e5b3d7ab8537cd5a10dc31d5ffa8f82d1 \
    && git submodule update --init --recursive \
    && cmake -S . -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target telegram-bot-api --parallel "$BUILD_JOBS"

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 libstdc++6 zlib1g \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -u 10001 -m ciro && mkdir /telegram-api && chown ciro:ciro /telegram-api
COPY --from=build /src/build/telegram-bot-api /usr/local/bin/telegram-bot-api
USER ciro
ENTRYPOINT ["telegram-bot-api", "--local", "--dir=/telegram-api", "--temp-dir=/telegram-api", "--verbosity=1"]

